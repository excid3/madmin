<% param = page.param.delete_suffix("page") + "per_page" %>
<form class="per-page" data-controller="per-page">
  <%= index_params_fields except: [page.param, param] %>
  <label>
    <%= t("madmin.pagination.per_page") %>
    <%= select_tag param, options_for_select(Madmin::Page::PER_PAGE_OPTIONS, page.per_page), data: {action: "per-page#submit"} %>
  </label>
</form>
