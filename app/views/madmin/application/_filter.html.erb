<div class="filter-row" data-filter-row>
  <%= select_tag "filters[][column]", options_for_select(filter_column_options(resource), filter.column),
        id: nil, aria: {label: t("madmin.filters.column")}, data: {action: "filters#changeColumn"} %>

  <%= select_tag "filters[][operator]", options_for_select(filter_operator_options(filter.type), filter.operator),
        id: nil, aria: {label: t("madmin.filters.operator")}, data: {action: "filters#changeOperator"} %>

  <%= tag.input name: "filters[][value]", value: filter.value, id: nil,
        type: filter_input_type(filter.type), step: ("any" if filter.type == :number),
        hidden: !filter.value?, aria: {label: t("madmin.filters.value")} %>

  <button type="button" class="filter-remove" aria-label="<%= t("madmin.filters.remove") %>" data-action="filters#remove">&times;</button>
</div>
